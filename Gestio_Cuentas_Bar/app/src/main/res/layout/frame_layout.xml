<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/frame"
    >

    <EditText
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:id="@+id/textoCuenta"
        android:hint="@string/texto_cuenta"

        />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center|center_horizontal"
        android:id="@+id/textoPropina"
        android:hint="@string/texto_propina"
        />

    <CheckBox
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center|center_horizontal"
        android:id="@+id/propina"


        />

    <SeekBar
        android:layout_width="1000px"
        android:layout_height="wrap_content"
        android:layout_gravity="center|center_horizontal"
        android:id="@+id/barraPropina"
        android:max="100"
        android:progress="10"
        />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center|center_horizontal"
        android:id="@+id/textoPorcentaje"

        />


    <RadioGroup
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/radioGroup"
        tools:ignore="ExtraText"
        android:layout_gravity="center|center_horizontal"

        >
            <RadioButton
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/tarjeta"
                android:text="@string/tarjeta"

                />

            <RadioButton
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/efectivo"
                android:text="@string/efectivo"

                />

    </RadioGroup>

    <RatingBar
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/ratingBarra"
        android:numStars="5"
        android:stepSize="0.5"
        android:rating="0"
        android:layout_gravity="center|center_horizontal"

        />

    <Button
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/calculoTotal"
        android:text="@string/calcular_total"
        android:layout_gravity="bottom|center_horizontal"
        />


</FrameLayout>